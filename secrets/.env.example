# Copy this file to secrets/.env and fill in real values.
# secrets/.env is gitignored - never commit real keys.
ANTHROPIC_API_KEY=

# Optional - Gmail, Calendar, Docs, Drive, Sheets, and Slides tools
# (search_email, send_email, list_calendar_events, create_calendar_event,
# read/create/append_to/replace_in doc, search/upload_to Drive, read/create/
# append/update Sheets, read/create/append/replace_text Slides) and
# proactive new-email/upcoming-event alerts. Nova runs fine without these
# set; those specific tools just report themselves unavailable, and the
# overlay pops up a Client ID/Secret prompt the moment one is actually
# attempted (see Overlay/Skins/CredentialsPopup.cs) - so these can be left
# blank and filled in later from there instead of editing this file by
# hand. To get the values either way:
#   1. https://console.cloud.google.com/ - create a project (or use an existing one).
#   2. APIs & Services > Enabled APIs & services > Enable each of these six -
#      all of them, not just the ones for tools you think you'll use, since
#      a disabled API fails at call time (a 403), not at startup, and it can
#      take a few minutes after enabling before it actually takes effect:
#        - Gmail API
#        - Google Calendar API
#        - Google Docs API
#        - Google Drive API
#        - Google Sheets API
#        - Google Slides API
#   3. APIs & Services > OAuth consent screen - set it up for "External" user
#      type (or "Internal" if you have Google Workspace); it's fine to leave
#      it in "Testing" status - add your own Google account under "Test
#      users" so you can actually sign in without Google's app-review process.
#   4. APIs & Services > Credentials > Create Credentials > OAuth client ID >
#      Application type "Desktop app". Copy the generated Client ID and
#      Client Secret below.
#   5. First run after setting these: Nova opens your browser for a one-time
#      consent screen, then caches a refresh token in data/google-token/
#      (gitignored) - no browser needed on later runs unless you revoke access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
